  "subs": [
    { "t0": 0.0,  "t1": 3.3,  "text": "เสียงนั้นดังอยู่เหนือหัวเรา" },
    { "t0": 3.3,  "t1": 7.0,  "text": "แต่ไม่มีเครื่องบินแม้แต่ลำเดียว" },
    { "t0": 7.4,  "t1": 10.6, "text": "พรานชัยพาเราเดินลึกเข้าไป" },
    { "t0": 10.6, "t1": 14.0, "text": "ทางเดินเริ่มแคบลงทุกที" },
    { "t0": 14.4, "t1": 18.0, "text": "วิทยุของฉันเริ่มส่งเสียงแปลก ๆ" },
    { "t0": 18.0, "t1": 21.0, "text": "ทั้งที่ไม่มีสัญญาณเลย" },
    { "t0": 21.4, "t1": 25.4, "text": "แล้วก็มีเสียงใครบางคนเรียกนิรันดร์" },
    { "t0": 25.4, "t1": 28.5, "text": "จากในป่าที่ไม่มีใครอยู่" },
    { "t0": 29.0, "t1": 32.2, "text": "พรานชัยรีบห้ามเกียรติ" },
    { "t0": 32.2, "t1": 36.2, "text": "อย่าตอบมันเด็ดขาด", "spk": "chai" },
    { "t0": 37.0, "t1": 41.0, "text": "แต่เสียงนั้นกลับดังขึ้น" },
    { "t0": 41.0, "t1": 46.0, "text": "ทั้งที่เราไม่ได้ขยับไปไหนเลย" },
    { "t0": 46.8, "t1": 50.0, "text": "พรานชัยสั่งให้เราเดินต่อ" },
    { "t0": 50.0, "t1": 55.0, "text": "แต่เสียงฝีเท้าที่ตามมา...มีมากกว่าพวกเรา" }
  ],
