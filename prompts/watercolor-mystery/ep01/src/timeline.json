{
  "title": "ตะเกียงริมคลอง",
  "dur": 56.0,
  "fps": 30,
  "size": [1080, 1920],
  "bpm": 60,
  "subs": [
    { "t0": 0.6,  "t1": 4.6,  "text": "คืนที่สาม…/ตะเกียงดวงนั้นจุดขึ้นอีกแล้ว" },
    { "t0": 5.4,  "t1": 9.6,  "text": "บ้านไม้ริมคลองหลังนี้/ร้างมาสามสิบปีแล้ว" },
    { "t0": 10.0, "t1": 14.6, "text": "แต่ทุกคืนตอนตีสาม/ตะเกียงบนระเบียงจะสว่างขึ้นเอง" },
    { "t0": 15.6, "t1": 20.0, "text": "ข้างตะเกียง มีรองเท้าแตะเปียกน้ำ/วางอยู่คู่หนึ่ง" },
    { "t0": 20.6, "t1": 25.6, "text": "และรอยเท้าเปียก/ที่เดินขึ้นมาจากคลอง" },
    { "t0": 27.4, "t1": 31.0, "text": "แต่ไม่เคยมีใคร/ขึ้นมาจากน้ำเลย" },
    { "t0": 31.6, "t1": 35.6, "text": "คืนนี้ ฉันนั่งวาดบ้านหลังนั้น/จากอีกฝั่งคลอง", "pos": "high" },
    { "t0": 36.0, "t1": 40.4, "text": "แล้วรอยเท้าเปียก/ก็เริ่มปรากฏบนกระดาษของฉัน", "pos": "high" },
    { "t0": 40.8, "t1": 44.6, "text": "ตะเกียงในภาพ/ดับลงเอง", "pos": "high" },
    { "t0": 45.4, "t1": 49.6, "text": "แต่ข้างหลังฉัน…/มีแสงตะเกียงสว่างขึ้น", "pos": "high" }
  ],
